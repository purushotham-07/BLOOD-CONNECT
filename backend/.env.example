PORT=5000
NODE_ENV=production

# Render/Neon/Supabase/Cloud PostgreSQL connection string with PostGIS enabled
# Example: postgresql://postgres:password@ep-xyz.render.com/bloodconnect?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/bloodconnect

JWT_SECRET=super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend Vercel domain(s), comma-separated or single URL
# Example: https://bloodconnect.vercel.app
CLIENT_URL=http://localhost:5173

BLOOD_REQUEST_RADIUS_KM=10
MATCHING_RADIUS_NORMAL_KM=10
MATCHING_RADIUS_URGENT_KM=20
MATCHING_RADIUS_CRITICAL_KM=30
MATCHING_RESULT_LIMIT=50
DONATION_INTERVAL_DAYS=56
