# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/bloodconnect

# Auth
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# CORS origin for the React frontend
CLIENT_URL=http://localhost:5173

# Matching
# Default notification radius (km) used when a donor does not supply one.
BLOOD_REQUEST_RADIUS_KM=10

# Request search radius (km) selected by the request's urgency level.
# These are configurable and must NOT be hardcoded in the application.
MATCHING_RADIUS_NORMAL_KM=10
MATCHING_RADIUS_URGENT_KM=20
MATCHING_RADIUS_CRITICAL_KM=30

# Upper bound on donors returned per request.
MATCHING_RESULT_LIMIT=50

# Donor eligibility rule (days between donations) - server-side configurable
# MUST be reviewed by qualified blood-bank staff before enabling donations.
DONATION_INTERVAL_DAYS=56
